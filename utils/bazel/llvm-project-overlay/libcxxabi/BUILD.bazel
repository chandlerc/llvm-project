licenses(["notice"])

package(
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "libcxxabi_hdrs",
    srcs = glob(["include/*.h"]),
)

filegroup(
    name = "libcxxabi_srcs",
    srcs = glob([
        "src/**/*.cpp",
        "src/**/*.def",
        "src/**/*.inc",
        "src/**/*.h",
    ]),
)
